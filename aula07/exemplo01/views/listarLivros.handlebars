<html>
<head>
    <title>Lista de livros</title>

    <style>
        div{
            border: 1px solid black;
            margin: 5px;
            width: 35vw;
            text-align: center;
            padding: 10px;
            border-radius: 5px;
            font-family: monospace;
            font-size: 16px;

        }
        div:hover{
            transform: scale(1.05);
            transition: 0.2s;
            background-color: #f0f0f0;
            font-size: 18px
        }
        body{
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
        }

        h1{
            font-family: monospace;
            margin-bottom: 20px;
        }

        a{
            text-decoration: none; 
            color: black;
        }
    </style>
</head>
<body>
    <h1>Lista de livros</h1>

    {{#each livros}}
        <a href="/livros/{{this.id}}">
            <div>
                {{this.titulo}}
            </div>
        </a>
    {{/each}}
</body>
</html>